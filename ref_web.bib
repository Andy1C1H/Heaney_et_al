@inproceedings{Heaney2025,
   abstract = {Women have been underrepresented in medical research in the past; this, in conjunction with implicit biases women receive, can lead to a decrease in the standard of care. Artificial intelligence (AI) systems have the potential to aid in creating fairer healthcare for women. However, there is still a need to give more definition to the problem to fully understand when women are biased against unfairly and, conversely when sex is a factor for a good reason. 15 semi-structured interviews were conducted with healthcare practitioners to gather their perceptions on women's healthcare. A semantic thematic analysis of these interviews yielded the following themes: Gender Influencing Health, Pregnancy, Social Factors, General Health, Treatment, Research and Training. These themes highlight that context is key to understanding the biases in women's health and that this context is critical when developing AI models for healthcare.},
   author = {Andrea Heaney and Emma Murphy and Eugene Hickey},
   city = {Cham},
   doi = {https://doi.org/10.1007/978-3-031-85572-6_11},
   editor = {Kondylakis Haridimos and Andreas Triantafyllidis},
   isbn = {978-3-031-85572-6},
   booktitle = {Pervasive Computing Technologies for Healthcare},
   pages = {179-197},
   publisher = {Springer Nature Switzerland},
   title = {Bias in Context: Clinicians' Perceptions of Women's Healthcare},
   year = {2025}
}
@inproceedings{Heaney2026,
   author = {Andrea Heaney and Emma Murphy and Eugene Hickey},
   doi = {10.1007/978-3-032-00656-1_8},
   booktitle = {Artificial Intelligence in Healthcare. AIiH},
